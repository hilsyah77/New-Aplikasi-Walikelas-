rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Validation Helper
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 200)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2000)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    // Class Record Validation Helper
    function isValidClassRecord(data) {
      return data.id is string && data.id.size() <= 128 &&
        (!('className' in data) || (data.className is string && data.className.size() <= 100)) &&
        (!('schoolName' in data) || (data.schoolName is string && data.schoolName.size() <= 200)) &&
        (!('academicYear' in data) || (data.academicYear is string && data.academicYear.size() <= 50)) &&
        (!('semester' in data) || (data.semester is string && data.semester.size() <= 20)) &&
        (!('teacherName' in data) || (data.teacherName is string && data.teacherName.size() <= 200)) &&
        (!('teacherNip' in data) || (data.teacherNip is string && data.teacherNip.size() <= 100)) &&
        (!('maleCount' in data) || (data.maleCount is number && data.maleCount >= 0 && data.maleCount <= 5000)) &&
        (!('femaleCount' in data) || (data.femaleCount is number && data.femaleCount >= 0 && data.femaleCount <= 5000)) &&
        (!('statementPlace' in data) || (data.statementPlace is string && data.statementPlace.size() <= 200)) &&
        (!('statementDate' in data) || (data.statementDate is string && data.statementDate.size() <= 100)) &&
        (!('statementAgreed' in data) || data.statementAgreed is bool) &&
        (!('signatureDataUrl' in data) || (data.signatureDataUrl is string && data.signatureDataUrl.size() <= 500000)) &&
        (!('signedAt' in data) || (data.signedAt is string && data.signedAt.size() <= 100)) &&
        (!('summary' in data) || data.summary is map) &&
        (!('students' in data) || (data.students is list && data.students.size() <= 500)) &&
        (!('generalDocuments' in data) || (data.generalDocuments is list && data.generalDocuments.size() <= 300)) &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isValidId(userId);
    }

    // Classes collection
    match /classes/{classId} {
      allow read: if true;
      allow create: if isValidId(classId) && isValidClassRecord(incoming());
      allow update: if isValidId(classId) && isValidClassRecord(incoming()) && incoming().id == existing().id;
      allow delete: if isValidId(classId);
    }

    // Test connection document
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}

