{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data for registered teachers or staff",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique Firebase Authentication UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when profile was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when profile was last updated"
        }
      },
      "required": ["userId", "email", "createdAt", "updatedAt"]
    },
    "ClassRecord": {
      "title": "ClassRecord",
      "description": "Class recapitulation record including student lists, counts, documents, and digital signature",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique class identifier"
        },
        "schoolName": {
          "type": "string",
          "description": "School name"
        },
        "academicYear": {
          "type": "string",
          "description": "Academic year (e.g. 2025/2026)"
        },
        "semester": {
          "type": "string",
          "enum": ["Ganjil", "Genap"],
          "description": "Semester"
        },
        "className": {
          "type": "string",
          "description": "Class name / grade"
        },
        "teacherName": {
          "type": "string",
          "description": "Teacher / homeroom teacher name"
        },
        "teacherNip": {
          "type": "string",
          "description": "Teacher NIP"
        },
        "maleCount": {
          "type": "number",
          "description": "Male student count"
        },
        "femaleCount": {
          "type": "number",
          "description": "Female student count"
        },
        "statementPlace": {
          "type": "string",
          "description": "Place where statement was signed"
        },
        "statementDate": {
          "type": "string",
          "description": "Date of statement"
        },
        "statementAgreed": {
          "type": "boolean",
          "description": "Agreement checkbox state"
        },
        "signatureDataUrl": {
          "type": "string",
          "description": "Digital signature image base64"
        },
        "signedAt": {
          "type": "string",
          "description": "Timestamp when signed"
        },
        "summary": {
          "type": "object",
          "description": "Complete summary object"
        },
        "students": {
          "type": "array",
          "description": "List of new, mutasi, and drop out students"
        },
        "generalDocuments": {
          "type": "array",
          "description": "List of general document proofs uploaded"
        },
        "userId": {
          "type": "string",
          "description": "Owner UID who created or last saved the record"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Record creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Record last update timestamp"
        }
      },
      "required": ["id", "className", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profile information"
    },
    "/classes/{classId}": {
      "schema": "ClassRecord",
      "description": "Stores class recapitulation, student list, and validation data"
    }
  }
}
